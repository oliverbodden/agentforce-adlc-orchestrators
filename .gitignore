# Python cache
__pycache__/
*.pyc
**/.venv/
**/venv/

# macOS
.DS_Store

# Local backups
*.bak
*.bak-*
.backups/

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# ADLC scratch — temporary/diagnostic files, not shipped
adlc/scratch/

# HelpIQ eval run outputs (raw results, reports) — keep under evals/ in git only
**/eval-runs/

# Per-ticket ADLC scratch (discovery, HITL, attempts) — not source of truth
adlc/agents/**/tickets/

# Local agent workspace noise
adlc/agents/**/baselines/
adlc/agents/**/version-archive/

# force-app ships empty buckets only; deploy metadata lives in the production agent repo
force-app/main/default/aiAuthoringBundles/**
!force-app/main/default/aiAuthoringBundles/.gitkeep
force-app/main/default/aiEvaluationDefinitions/**
!force-app/main/default/aiEvaluationDefinitions/.gitkeep
force-app/main/default/bots/**
!force-app/main/default/bots/.gitkeep
force-app/main/default/genAiFunctions/**
force-app/main/default/genAiPlugins/**
force-app/main/default/genAiPromptTemplates/**
!force-app/main/default/genAiPromptTemplates/.gitkeep
force-app/main/default/genAiPlannerBundles/**
!force-app/main/default/genAiPlannerBundles/.gitkeep

# Temporary deploy manifests
manifest-tmp/

# SSH keys — never commit private keys to any repo
oliver
oliver.pub
*.pem
id_*
*_rsa
*_ed25519
*.key

# Personal symlinks — point to user-specific paths, won't work elsewhere
.skills

# ADLC drive resumability scratchpad — local-only, not durable state
.adlc-drive-state.json

# ADLC bootstrap install evidence and migration scratch — local-only
adlc/versioning/bootstrap-*.json
adlc/versioning/*-status-*.json
adlc/versioning/local-overlay-manifest.json
adlc/versioning/upstream-*.json
adlc/versioning/upstream-*.md
adlc/versioning/PLAN_EXECUTION_STATUS.md
adlc/versioning/skill-regression-initial.md
adlc/versioning/target-structure-review.md
adlc/versioning/bootstrap-migration-checkpoint.md
adlc/versioning/phase*-reference-check.md
!adlc/versioning/.gitkeep

# Vendored upstream Salesforce skills — runtime-fetched, not committed.
adlc/skills/upstream/*/
adlc/skills/upstream/SOURCE.md
!adlc/skills/upstream/README.md
!adlc/skills/upstream/.gitkeep
